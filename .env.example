# ==========================================
# FORGENT — LOCAL DEVELOPMENT ENVIRONMENT
# ==========================================

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Neon PostgreSQL
# Pooled connection — application runtime
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DB?sslmode=require"

# Direct connection — migrations and schema operations
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST/DB?sslmode=require"

# ==========================================
# FUTURE PHASES — LEAVE EMPTY FOR P0
# ==========================================

# Auth.js / Google OAuth — P1
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Support agent model — OpenRouter free-model router
OPENROUTER_API_KEY=""

# Upstash Redis — later runtime/cache work
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Upstash QStash — later durable execution work
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# UploadThing — optional future file uploads
UPLOADTHING_TOKEN=""

# Discord bot (local demo; keep these values in .env.local)
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""
DISCORD_SUPPORT_CHANNEL_ID=""
DISCORD_STAFF_CHANNEL_ID=""
DISCORD_AGENT_ID=""
FORGENT_API_KEY=""
